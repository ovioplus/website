# env — NEVER commit secrets. `.env*.local` alone missed a bare `.env`,
# which is where a Resend key would most likely end up.
.env
.env*.local
.DS_Store
*.log
.vercel
next-env.d.ts
tsconfig.tsbuildinfo

# This repo is npm-managed (CI runs `npm ci`, package-lock.json is the lockfile).
# A stray `pnpm install` writes these, and a second lockfile silently drifts from
# the one CI actually uses. Keep them out.
pnpm-lock.yaml
pnpm-workspace.yaml
